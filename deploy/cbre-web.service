[Unit]
Description=CBRE inspection portal
After=network.target cbre-api.service
Wants=cbre-api.service

[Service]
Type=simple
User=cbre
Group=cbre
WorkingDirectory=/var/www/cbre
EnvironmentFile=/var/www/cbre/.env.production
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3200
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/cbre/.next
UMask=0027

[Install]
WantedBy=multi-user.target
